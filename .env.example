APP_NAME="Gestione Associazioni"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database principale (MySQL 8 — schema con UUID CHAR(36))
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=associazione_soci_laravel
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# Database legacy (vecchia app procedurale) — usato SOLO da
# `php artisan app:import-legacy` per importare i dati esistenti.
# ------------------------------------------------------------------
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=associazione_soci_saas
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# 'file' permette il primo avvio senza database (l'installer web /install
# configura poi MySQL); dopo l'installazione puoi passare a 'database'.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail di piattaforma (notifiche backup/health, fallback di sistema).
# L'invio delle comunicazioni ai soci usa gli SMTP per-associazione
# salvati nella tabella `smtp_settings` (configurabili da interfaccia).
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Ricerca full-text soci (Laravel Scout, driver database: nessun
# servizio esterno richiesto)
# ------------------------------------------------------------------
SCOUT_DRIVER=database
SCOUT_QUEUE=false
# SCOUT_PREFIX=

# ------------------------------------------------------------------
# Backup (spatie/laravel-backup) — `php artisan backup:run`
# ------------------------------------------------------------------
BACKUP_NOTIFICATION_MAIL=admin@example.com
# Password per cifrare gli archivi zip di backup (vuota = non cifrati)
BACKUP_ARCHIVE_PASSWORD=

# ------------------------------------------------------------------
# Pagamenti quote (Stripe + PayPal).
# Le credenziali di produzione sono PER ASSOCIAZIONE e si configurano
# da interfaccia (tabella `payment_gateway_settings`), non via env.
# Le chiavi qui sotto servono solo come comodo per sviluppo/test.
# ------------------------------------------------------------------
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------
# API v1 (Sanctum + api_keys legacy) e documentazione Scramble
# ------------------------------------------------------------------
API_VERSION=v1
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# SANCTUM_TOKEN_PREFIX=

# ------------------------------------------------------------------
# Sicurezza: Content-Security-Policy, audit log, honeypot anti-spam
# ------------------------------------------------------------------
CSP_ENABLED=true
CSP_NONCE_ENABLED=true
# CSP_REPORT_URI=
ACTIVITYLOG_ENABLED=true
HONEYPOT_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
