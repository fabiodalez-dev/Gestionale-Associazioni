# Gestione Associazioni — radice del progetto usata come web root.
#
# Serve agli hosting condivisi dove la document root (public_html) non si può
# cambiare: tutte le richieste passano da public/, così app/, storage/,
# vendor/ e .env non sono mai raggiungibili dal browser. Se puoi scegliere la
# document root, puntala a public/ e questo file non interviene.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prefisso URL della cartella che contiene questo file ("" alla radice,
    # "/gestionale" in sottocartella). Serve perché la sostituzione relativa
    # "public/$1" fallisce con 500 su alcuni hosting (IONOS) in cui la
    # document root è un symlink e Apache non riesce a ricavare il prefisso.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule ^.*$ - [E=BASE:%1]

    RewriteRule ^(?!public/)(.*)$ %{ENV:BASE}/public/$1 [L,QSA]
</IfModule>

# Difesa in profondità: questi file non vanno mai serviti, nemmeno senza mod_rewrite
<FilesMatch "^(\.env.*|\.git.*|\.htaccess|composer\.(json|lock)|package(-lock)?\.json|VERSION|artisan|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
