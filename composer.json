{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fabiodalez-dev/gestione-associazioni",
    "version": "0.1.0",
    "type": "project",
    "description": "Piattaforma SaaS multi-tenant per la gestione completa di associazioni.",
    "keywords": ["laravel", "associazioni", "crm", "multi-tenant"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "chillerlan/php-qrcode": "^6.0",
        "dedoc/scramble": "^0.13.26",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.2",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "metalogico/laravel-formello": "^2.1",
        "mews/purifier": "^3.4",
        "propaganistas/laravel-phone": "^6.0",
        "robertogallea/laravel-codicefiscale": "^2.3",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-csp": "^3.25",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-failed-job-monitor": "^4.5",
        "spatie/laravel-google-calendar": "^3.8",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-personal-data-export": "^4.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-schedule-monitor": "^4.3",
        "spatie/laravel-settings": "^3.9",
        "srmklive/paypal": "^3.1",
        "stripe/stripe-php": "^20.2",
        "ziming/laravel-zxcvbn": "^2.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.3",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "shipmonk/dead-code-detector": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "analyse": "phpstan analyse --no-progress --memory-limit=2G",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "pre-autoload-dump": [
            "Google\\Task\\Composer::cleanup"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "google/apiclient-services": [
            "Calendar"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
